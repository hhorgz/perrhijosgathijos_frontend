---
const {title, subtitle} = Astro.props;
---
<div class="bg-background p-8">
    <h2 class="md:text-2xl text-sm font-light tracking-wider text-center font-sans">
        {subtitle}
    </h2>
    <h1 class="md:text-8xl text-2xl font-extrablack tracking-tight font-anek uppercase text-center">
        {title}
    </h1>
</div>